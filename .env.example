# Node.js 24 ou superior. Não há serviço externo obrigatório.
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/financia.db
APP_TIMEZONE=America/Rio_Branco
# HOST é 127.0.0.1 em desenvolvimento e 0.0.0.0 em produção.
# HOST=0.0.0.0
# No Render, APP_ORIGIN pode ser omitida: usa RENDER_EXTERNAL_URL automaticamente.
# DATABASE_PATH=/var/data/financia.db
# Produção: NODE_ENV=production, APP_ORIGIN=https://seu-dominio e HTTPS no proxy.
# NODE_ENV=production
# TRUST_PROXY=1
