{
  "name": "financia-sites",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build-worker.mjs",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply financia-local --local",
    "sync:client": "node scripts/sync-client.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "vite": "^7.2.2",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
